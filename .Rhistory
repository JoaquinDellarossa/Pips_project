library(ggplot2)
power_t <- function(n, d, alpha, type = "two.sample", alternative = "two.sided") {
df  <- if (type == "one.sample") n - 1 else 2 * (n - 1)
ncp <- if (type == "one.sample") d * sqrt(n) else d * sqrt(n / 2)
if (alternative == "two.sided") {
