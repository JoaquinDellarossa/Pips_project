pow   <- pt(tcrit, df, ncp, lower.tail = FALSE) + pt(-tcrit, df, ncp)
} else {
tcrit <- qt(1 - alpha, df)
pow   <- pt(tcrit, df, ncp, lower.tail = FALSE)
}
list(df = df, ncp = ncp, tcrit = tcrit, power = pow)
}
